    <fullName>Closed_Reason__c</fullName>
    <description>Set when a link was ended before its expiry, rather than simply timing out. Locked: too many wrong codes or too many code requests. Superseded: a newer link was issued to the same address.</description>
    <label>Closed Reason</label>
    <required>false</required>
    <trackHistory>true</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>View limit reached</fullName>
                <default>false</default>
                <label>View limit reached</label>
            </value>
            <value>
                <fullName>Manually revoked</fullName>
                <default>false</default>
                <label>Manually revoked</label>
            </value>
            <value>
                <fullName>Locked</fullName>
                <default>false</default>
                <label>Locked</label>
            </value>
            <value>
                <fullName>Superseded</fullName>
                <default>false</default>
                <label>Superseded</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
