<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Latest_Discharge_Run_Date_3_Hours_Old__c</fullName>
    <formula>ISBLANK( Latest_Discharge_Run_Date__c ) || 
(NOW() - Latest_Discharge_Run_Date__c) * 24 &gt; 0.75</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Latest Discharge Run Date 3 Hours Old</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
