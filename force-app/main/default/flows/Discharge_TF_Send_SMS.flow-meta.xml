        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Text_Sent_Within_2_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>textLast2Days</leftValueReference>
