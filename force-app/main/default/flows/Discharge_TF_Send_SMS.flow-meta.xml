    <decisions>
        <name>If_Discharged_Home</name>
        <label>If Discharged Home</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Discharged_Home</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>dischargedHome</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Patient__r.No_Texts__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Text_Sent_Within_2_Days</targetReference>
            </connector>
            <label>Discharged Home</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_GHC</name>
        <label>If GHC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>GHC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Patient__r.Facility__r.Parent_Company__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>GHC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_MD_DE_or_NJ</targetReference>
            </connector>
            <label>GHC</label>
        </rules>
        <rules>
            <name>Complete_Care</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Patient__r.Facility__r.Parent_Company__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Complete Care</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_PA_or_NJ</targetReference>
            </connector>
            <label>Complete Care</label>
        </rules>
        <rules>
            <name>Infinity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Patient__r.Facility__r.Parent_Company__r.Name</leftValueReference>
