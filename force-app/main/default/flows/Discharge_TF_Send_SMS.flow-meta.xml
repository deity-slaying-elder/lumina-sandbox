    <environments>Default</environments>
    <formulas>
        <name>dischargedHome</name>
        <dataType>Boolean</dataType>
        <expression>IF(
AND(
TEXT({!$Record.Type__c}) = &quot;Discharge&quot;,
OR(
CONTAINS(LOWER(TRIM({!$Record.To_From_Type__c})), &quot;home&quot;),
CONTAINS(LOWER(TRIM({!$Record.To_From_Type__c})), &quot;alf&quot;),
CONTAINS(LOWER(TRIM({!$Record.To_From_Type__c})), &quot;assisted&quot;)),
NOT(
OR(
CONTAINS(LOWER(TRIM({!$Record.To_From_Type__c})), &quot;funeral&quot;),
CONTAINS(LOWER(TRIM({!$Record.To_From_Type__c})), &quot;nursing&quot;),
CONTAINS(LOWER(TRIM({!$Record.To_From_Type__c})), &quot;hospice&quot;)
)
)
),
TRUE,
FALSE
)</expression>
    </formulas>
    <formulas>
        <name>IL</name>
        <dataType>Boolean</dataType>
        <expression>or(
{!$Record.Patient__r.Facility_State__c} = &apos;IL&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;Illinois&apos;
)</expression>
    </formulas>
    <formulas>
        <name>MDDENJ</name>
        <dataType>Boolean</dataType>
        <expression>or(
{!$Record.Patient__r.Facility_State__c} = &apos;NJ&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;MD&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;DE&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;New Jersey&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;Maryland&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;Deleware&apos;
)</expression>
    </formulas>
    <formulas>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>now()</expression>
    </formulas>
    <formulas>
        <name>PANJ</name>
        <dataType>Boolean</dataType>
        <expression>or(
{!$Record.Patient__r.Facility_State__c} = &apos;NJ&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;PA&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;New Jersey&apos;,
{!$Record.Patient__r.Facility_State__c} = &apos;Pennsylvania&apos;
)</expression>
    </formulas>
    <formulas>
        <name>phoneNumber</name>
        <dataType>String</dataType>
        <expression>if(
not(isblank({!$Record.Patient__r.Phone_Number__c})),
{!$Record.Patient__r.Phone_Number__c},
if(
not(isblank({!$Record.Patient__r.Mobile_Number__c})),
{!$Record.Patient__r.Mobile_Number__c},
if(
not(isblank({!$Record.Patient__r.Main_Phone_Number__c})),
{!$Record.Patient__r.Main_Phone_Number__c},
if(
not(isblank({!$Record.Patient__r.Phone_1__c})),
{!$Record.Patient__r.Phone_1__c},
if(
not(isblank({!$Record.Patient__r.Phone_2__c})),
{!$Record.Patient__r.Phone_2__c},
if(
not(isblank({!$Record.Patient__r.Phone_3__c})),
{!$Record.Patient__r.Phone_3__c},
null
))))))</expression>
    </formulas>
    <formulas>
        <name>textLast2Days</name>
        <dataType>Boolean</dataType>
        <expression>if(
today() - datevalue({!$Record.Patient__r.Last_SMS_Sent_Date__c}) &gt; 3,
true,
false
)</expression>
    </formulas>
