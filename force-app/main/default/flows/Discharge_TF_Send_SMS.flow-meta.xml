                <rightValue>
                    <stringValue>Infinity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IL</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
