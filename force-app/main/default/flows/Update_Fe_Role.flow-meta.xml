<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_1</name>
        <label>ConcatStringAssignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AllRoles</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ConcatString</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Role_Loop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_2</name>
        <label>RemoveComma</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AllRoles</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RemoveCommaFormula</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>UpdateRoleInFe</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>ConcatString</name>
        <dataType>String</dataType>
        <expression>{!$Record.Role__r.Name} &amp; &quot;, &quot;</expression>
    </formulas>
    <formulas>
        <name>RemoveCommaFormula</name>
        <dataType>String</dataType>
        <expression>LEFT({!AllRoles}, LEN({!AllRoles}) - 2)</expression>
    </formulas>
    <interviewLabel>Update Fe Role {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Fe Role</label>
    <loops>
        <name>Role_Loop</name>
        <label>Role Loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Fe_User_Role</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assignment_1</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Assignment_2</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Fe_User_Role</name>
        <label>Get Fe User Role</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Role_Loop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Front_End_User__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Front_End_User__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FE_User_Role__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>UpdateRoleInFe</name>
        <label>UpdateRoleInFe</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Front_End_User__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Role__c</field>
            <value>
                <elementReference>AllRoles</elementReference>
            </value>
        </inputAssignments>
        <object>Front_End_User__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Fe_User_Role</targetReference>
        </connector>
        <object>FE_User_Role__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>AllRoles</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
