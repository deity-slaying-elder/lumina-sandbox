    <formulas>
        <name>IL</name>
        <dataType>Boolean</dataType>
        <expression>or(
{!$Record.Facility_State__c} = &apos;IL&apos;,
{!$Record.Facility_State__c} = &apos;Illinois&apos;
)</expression>
    </formulas>
    <formulas>
