    <formulas>
        <name>PANJ</name>
        <dataType>Boolean</dataType>
        <expression>or(
{!$Record.Facility_State__c} = &apos;NJ&apos;,
{!$Record.Facility_State__c} = &apos;PA&apos;,
{!$Record.Facility_State__c} = &apos;New Jersey&apos;,
{!$Record.Facility_State__c} = &apos;Pennsylvania&apos;
)</expression>
    </formulas>
    <formulas>
        <name>phoneNumber</name>
        <dataType>String</dataType>
        <expression>if(
not(isblank({!$Record.Phone_Number__c})),
{!$Record.Phone_Number__c},
if(
not(isblank({!$Record.Mobile_Number__c})),
{!$Record.Mobile_Number__c},
if(
not(isblank({!$Record.Main_Phone_Number__c})),
{!$Record.Main_Phone_Number__c},
if(
not(isblank({!$Record.Main_Phone_Number__c})),
{!$Record.Main_Phone_Number__c},
null
)
)
)
)</expression>
    </formulas>
