{!$Record.Facility_State__c} = &apos;MD&apos;,
{!$Record.Facility_State__c} = &apos;DE&apos;,
{!$Record.Facility_State__c} = &apos;New Jersey&apos;,
{!$Record.Facility_State__c} = &apos;Maryland&apos;,
