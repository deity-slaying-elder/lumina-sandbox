<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>If_Initial</name>
        <label>If Initial</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Patient_Not_Initial</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Initial</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Patient__r.Initial_Visit_Date__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Patient_Initial</targetReference>
            </connector>
            <label>Initial</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Not_Seen</name>
        <label>If Not Seen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>If_Initial</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Seen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Not_Seen_Reason__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Patient_Not_Seen</targetReference>
            </connector>
            <label>Not Seen</label>
        </rules>
    </decisions>
    <description>update and create</description>
    <environments>Default</environments>
    <formulas>
        <name>VisitDate</name>
        <dataType>Date</dataType>
        <expression>datevalue({!$Record.Visit_DateTime__c})</expression>
    </formulas>
    <interviewLabel>Visit - TF - On Create Visit Fill Visit Date Fields on Patient {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Visit - TF - On Create Visit Fill Visit Date Fields on Patient</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Patient_Initial</name>
        <label>Update Patient Initial</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Patient__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Initial_Visit_Date__c</field>
            <value>
                <elementReference>VisitDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Initial_Visit_Provider__c</field>
            <value>
                <elementReference>$Record.Front_End_User__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Latest_Visit_DateTime__c</field>
            <value>
                <elementReference>$Record.Visit_DateTime__c</elementReference>
            </value>
        </inputAssignments>
        <object>Patient__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Patient_Not_Initial</name>
        <label>Update Patient Not Initial</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Patient__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Latest_Visit_DateTime__c</field>
            <value>
                <elementReference>$Record.Visit_DateTime__c</elementReference>
            </value>
        </inputAssignments>
        <object>Patient__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Patient_Not_Seen</name>
        <label>Update Patient Not Seen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Patient__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Latest_Not_Seen_DateTime__c</field>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </inputAssignments>
        <object>Patient__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_Not_Seen</targetReference>
        </connector>
        <object>Visit__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
