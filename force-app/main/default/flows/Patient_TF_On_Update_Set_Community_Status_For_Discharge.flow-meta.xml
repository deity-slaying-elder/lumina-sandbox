    <decisions>
        <name>If_Latest_Call_Outcome_More_Than_30_Days_Ago</name>
        <label>If Latest Call Outcome More Than 30 Days Ago</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>More_Than_30_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Call30Days</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Community_Status</targetReference>
            </connector>
            <label>More Than 30 Days</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_There_Is_Latest_Call_Outcome</name>
        <label>If There Is Latest Call Outcome</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Latest_Call_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Latest_Call_Outcome__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Latest_Call_Outcome_More_Than_30_Days_Ago</targetReference>
            </connector>
            <label>Latest Call Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Call30Days</name>
        <dataType>Boolean</dataType>
        <expression>if(
today() - {!$Record.Latest_Call_Outcome__c} &gt; 30,
true,
false
)</expression>
    </formulas>
    <interviewLabel>Patient - TF - On Update - Set Community Status For Discharge {!$Flow.CurrentDateTime}</interviewLabel>
